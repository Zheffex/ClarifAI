# ClarifAI Backend Environment Configuration

# ================== REQUIRED SETTINGS ==================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/clarifai

# JWT Configuration  
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# OpenRouter AI API
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=x-ai/grok-4-fast:free

# ================== OPTIONAL SETTINGS ==================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info

# Site Information
SITE_URL=http://localhost:3000
SITE_NAME=ClarifAI

# ================== NOTIFICATION SERVICES ==================

# Email Configuration (Optional - for email notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=ClarifAI <noreply@clarifai.com>
# EMAIL_SECURE=false

# Web Push Notifications (Optional - for browser push notifications)
# WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
# WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
# WEB_PUSH_CONTACT=mailto:admin@clarifai.com

# ================== NOTIFICATION SETUP GUIDE ==================

# EMAIL NOTIFICATIONS:
# 1. For Gmail, use app passwords: https://support.google.com/accounts/answer/185833
# 2. Set EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_SECURE=false
# 3. For other providers, check their SMTP settings