# ClarifAI Backend - Example Environment Variables
# Copy this file to .env and update values as needed.

NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/clarifai

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# CORS / URLs
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
SITE_NAME=ClarifAI

# Logging
LOG_LEVEL=debug

# File uploads
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Realtime / Caching (optional)
REDIS_URL=redis://localhost:6379

# OpenRouter AI (optional but recommended for AI features)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=x-ai/grok-4-fast:free

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ClarifAI <noreply@clarifai.com>"
EMAIL_SECURE=false

# Web push (optional)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=

# Encryption (optional)
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=default

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
