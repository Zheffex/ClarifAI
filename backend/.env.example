# ========================================
# ClarifAI Backend Environment Configuration
# ========================================
# Copy this file to .env and update the values
# DO NOT commit .env files to version control

# ========================================
# Database Configuration
# ========================================
# REQUIRED: MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/clarifai
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clarifai?retryWrites=true&w=majority

# ========================================
# JWT Security Configuration
# ========================================
# REQUIRED: Secret key for JWT tokens (use a strong, random key in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-256-bit-key
# JWT token expiration time
JWT_EXPIRES_IN=24h

# ========================================
# Server Configuration
# ========================================
# Port for the backend server
PORT=5000
# Environment (development, production, test)
NODE_ENV=development

# ========================================
# CORS Configuration
# ========================================
# Frontend URL for CORS (where your React app runs)
FRONTEND_URL=http://localhost:3000

# ========================================
# File Upload Configuration
# ========================================
# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800
# Upload directory path
UPLOAD_PATH=./uploads

# ========================================
# Logging Configuration
# ========================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ========================================
# OpenRouter AI API Configuration
# ========================================
# REQUIRED: Your OpenRouter API key
# Get one from: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key-here
# AI model to use
OPENROUTER_MODEL=x-ai/grok-4-fast:free
# Your site URL (for OpenRouter analytics)
SITE_URL=http://localhost:3000
# Your application name
SITE_NAME=ClarifAI

# ========================================
# Production Environment Example
# ========================================
# For production deployment, use these as reference:
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clarifai_prod
# JWT_SECRET=your-production-256-bit-secret-key
# FRONTEND_URL=https://your-domain.com
# SITE_URL=https://your-domain.com
# LOG_LEVEL=warn