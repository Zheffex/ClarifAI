# ========================================
# Test Environment Configuration
# ========================================
# This file is used for running tests
# DO NOT use these values in production

# Environment
NODE_ENV=test
PORT=5001

# JWT Configuration (test only)
JWT_SECRET=test-jwt-secret-key-for-testing-only-do-not-use-in-production-256-bits
JWT_EXPIRES_IN=7d

# Test Database (will be overridden by in-memory MongoDB in tests)
MONGODB_URI=mongodb://localhost:27017/clarifai_test

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3001

# Disable verbose logging in tests
LOG_LEVEL=error

# Test OpenRouter Configuration
OPENROUTER_API_KEY=test-api-key
OPENROUTER_MODEL=test-model
SITE_URL=http://localhost:3001
SITE_NAME=ClarifAI Test

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./test-uploads